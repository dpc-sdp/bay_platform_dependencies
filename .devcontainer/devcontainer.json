{
  "name": "Bay Platform Dependencies",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "XDEBUG_MODE": "off"
  },
  "postCreateCommand": "composer --working-dir=tools install --no-interaction --prefer-dist --no-progress",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  }
}
